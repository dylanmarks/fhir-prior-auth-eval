# Server/CLI only. Copy to .env; never use VITE_* for credentials.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Fill in current provider prices; no prices are guessed by the harness.
JEV_INPUT_PRICE_PER_MILLION=0.042
JEV_OUTPUT_PRICE_PER_MILLION=0
JEV_MAX_INPUT_TOKENS=16000
JEV_MAX_OUTPUT_TOKENS=2048
SMALL_LLM_MODEL=meta-llama/llama-3.2-3b-instruct
SMALL_LLM_INPUT_PRICE_PER_MILLION=0.05
SMALL_LLM_OUTPUT_PRICE_PER_MILLION=0.33

#SMALL_LLM_MODEL=qwen/qwen-2.5-7b-instruct
#SMALL_LLM_INPUT_PRICE_PER_MILLION=0.1
#SMALL_LLM_OUTPUT_PRICE_PER_MILLION=0.2

#SMALL_LLM_MODEL=meta-llama/llama-3.2-3b-instruct
#SMALL_LLM_INPUT_PRICE_PER_MILLION=0.05
#SMALL_LLM_OUTPUT_PRICE_PER_MILLION=0.33

#SMALL_LLM_MODEL=google/gemini-2.0-flash-lite
#SMALL_LLM_INPUT_PRICE_PER_MILLION=0.075
#SMALL_LLM_OUTPUT_PRICE_PER_MILLION=0.30

SMALL_LLM_MAX_INPUT_TOKENS=16000
# Tier 4: Frontier Model Configuration

# Option A: ChatGPT Plan (Sol 6.1 example)
# Connect from the local web UI first (npm run serve + npm run dev -> Continue with ChatGPT).
FRONTIER_LLM_PROVIDER=chatgpt-plan
FRONTIER_LLM_MODEL=gpt-6.1-sol
# Supported reasoning efforts: none, minimal, low, medium, high, xhigh, max
FRONTIER_LLM_REASONING_EFFORT=xhigh
CHATGPT_AUTH_DIR=.chatgpt
FRONTIER_LLM_MAX_INPUT_TOKENS=16000
# ChatGPT output limit is a local reservation/check, not an upstream generation cap.
FRONTIER_LLM_MAX_OUTPUT_TOKENS=8192

# Option B: OpenRouter Alternative with Claude Opus 5.5 (commented out)
# Current OpenRouter pricing: $4.00 / 1M input, $20.00 / 1M output
# FRONTIER_LLM_PROVIDER=openrouter
# FRONTIER_LLM_MODEL=anthropic/claude-opus-5.5
# FRONTIER_LLM_INPUT_PRICE_PER_MILLION=4.00
# FRONTIER_LLM_OUTPUT_PRICE_PER_MILLION=20.00
# FRONTIER_LLM_MAX_INPUT_TOKENS=16000
# FRONTIER_LLM_MAX_OUTPUT_TOKENS=2048
CASE_BUDGET_USD=0.10
CASE_TOKEN_BUDGET=100000