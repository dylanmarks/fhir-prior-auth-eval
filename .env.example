# Server/CLI only. Copy to .env; never use VITE_* for credentials.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Fill in current provider prices; no prices are guessed by the harness.
JEV_INPUT_PRICE_PER_MILLION=
JEV_OUTPUT_PRICE_PER_MILLION=
JEV_MAX_INPUT_TOKENS=16000
JEV_MAX_OUTPUT_TOKENS=2048
SMALL_LLM_MODEL=
SMALL_LLM_INPUT_PRICE_PER_MILLION=
SMALL_LLM_OUTPUT_PRICE_PER_MILLION=
SMALL_LLM_MAX_INPUT_TOKENS=16000
FRONTIER_LLM_MODEL=
# Optional: openrouter (default) or chatgpt-plan. Connect from the local web UI first.
FRONTIER_LLM_PROVIDER=openrouter
# For ChatGPT models: low, medium, high, xhigh, max, etc. Support is model-dependent.
FRONTIER_LLM_REASONING_EFFORT=
# Local credential directory (ignored by Git; keep credentials out of source control).
CHATGPT_AUTH_DIR=.chatgpt
# ChatGPT output limit is a local reservation/check, not an upstream generation cap.
FRONTIER_LLM_MAX_OUTPUT_TOKENS=8192
FRONTIER_LLM_INPUT_PRICE_PER_MILLION=
FRONTIER_LLM_OUTPUT_PRICE_PER_MILLION=
FRONTIER_LLM_MAX_INPUT_TOKENS=16000
CASE_BUDGET_USD=0.10
CASE_TOKEN_BUDGET=100000
CASE_TIMEOUT_MS=120000
